# Synthetic backhoe attachment (open example; geometry in excavator.step, generated by gen_excavator.py)
# Machine plane x-y (x forward, y up), mm. Reference configuration = pose of the STEP model.
title Synthetic backhoe attachment (boom, arm, bucket with four-bar linkage)
gravity 0 -9.81

body boom arm bucket rocker link

revolute O ground boom    0.0     0.0
revolute F boom   arm     3300.0  1500.0
revolute G arm    bucket  3700.0  -300.0
revolute R arm    rocker  3620.0  0.0
revolute K rocker link    3880.0  60.0
revolute L link   bucket  3960.0  -230.0

# cylinders; masses = title-block masses scaled by cylload masstable (remainder share)
actuator S1   ground 450.0 -650.0  boom   1600.0 450.0  bore=125 rod=85 min=1300 max=2200 mass=98.17195326
actuator S2    boom   1800.0 1650.0  arm   3150.0 2050.0 bore=115 rod=80 min=1200 max=1950 mass=77.50417362
actuator S3 arm    3420.0 1250.0  rocker 3880.0 60.0  bore=100 rod=70 min=1050 max=1500 mass=53.73622705

hydraulics beta=1.0e9 dead_volume_piston=0.4 dead_volume_rod=0.6

masses excavator_masses.csv
